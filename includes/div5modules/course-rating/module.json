{
  "name": "tutor-lms/course-rating",
  "d4Shortcode": "tutor_course_rating",
  "title": "Tutor Course Rating",
  "titles": "Tutor Course Rating",
  "category": "module",
  "moduleClassName": "et_pb_tutor_course_rating",
  "moduleOrderClassName": "et_pb_tutor_course_rating",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Tutor Course Rating"
            }
          }
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "html": {}
        },
        "decoration": {
          "spacing": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      },
      "styleProps": {
        "spacing": {
          "important": true
        }
      }
    },
    "content": {
      "type": "object",
      "default": {
        "advanced": {
          "layout": {
            "desktop": {
              "value": "row"
            }
          },
          "alignment": {
            "desktop": {
              "value": "left"
            }
          }
        }
      },
      "settings": {
        "advanced": {
          "layout": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentMainContent",
              "attrName": "content.advanced.layout",
              "label": "Layout",
              "priority": 10,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "row": {
                      "label": "Left"
                    },
                    "column": {
                      "label": "Up"
                    }
                  }
                }
              }
            }
          },
          "alignment": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentMainContent",
              "attrName": "content.advanced.alignment",
              "label": "Alignment",
              "priority": 20,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": true
              },
              "component": {
                "type": "field",
                "name": "divi/button-options",
                "props": {
                  "options": {
                    "left": {
                      "icon": "divi/align-left"
                    },
                    "center": {
                      "icon": "divi/align-center"
                    },
                    "right": {
                      "icon": "divi/align-right"
                    }
                  },
                  "showLabel": false
                }
              }
            }
          },
          "gap": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designRating",
              "attrName": "content.advanced.gap",
              "label": "Rating Gap",
              "priority": 10,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 0,
                  "max": 100,
                  "step": 1,
                  "defaultUnit": "px",
                  "allowedUnits": ["%", "em", "rem", "px", "cm", "mm", "in", "pt", "pc", "ex", "vh", "vw"]
                }
              }
            }
          }
        }
      }
    },
    "stars": {
      "type": "object",
      "selector": "{{selector}} .dtlms-rating-wrapper .tutor-ratings-stars span",
      "default": {
        "advanced": {
          "color": {
            "desktop": {
              "value": "#ed9700"
            }
          }
        }
      },
      "settings": {
        "advanced": {
          "size": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designRatingStars",
              "attrName": "stars.advanced.size",
              "label": "Star Size",
              "priority": 10,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 10,
                  "max": 100,
                  "step": 1,
                  "defaultUnit": "px",
                  "allowedUnits": ["%", "em", "rem", "px", "cm", "mm", "in", "pt", "pc", "ex", "vh", "vw"]
                }
              }
            }
          },
          "gap": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designRatingStars",
              "attrName": "stars.advanced.gap",
              "label": "Star Gap",
              "priority": 20,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 0,
                  "max": 100,
                  "step": 1,
                  "defaultUnit": "px",
                  "allowedUnits": ["%", "em", "rem", "px", "cm", "mm", "in", "pt", "pc", "ex", "vh", "vw"]
                }
              }
            }
          },
          "color": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designRatingStars",
              "attrName": "stars.advanced.color",
              "label": "Star Color",
              "priority": 30,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/color-picker"
              }
            }
          }
        }
      }
    },
    "countText": {
      "type": "object",
      "selector": "{{selector}} .tutor-ratings .tutor-ratings-count",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designRatingStars",
              "priority": 40,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": {
                  "grouped": false,
                  "groupLabel": "Rating Stars",
                  "fieldLabel": "Count",
                  "fields": {
                    "headingLevel": {
                      "render": false
                    },
                    "textAlign": {
                      "render": false
                    }
                  }
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "{{selector}} .tutor-ratings .tutor-ratings-count",
          "important": true
        }
      }
    },
    "avgText": {
      "type": "object",
      "selector": "{{selector}} .tutor-ratings .tutor-ratings-average",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designRating",
              "priority": 20,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": {
                  "grouped": false,
                  "groupLabel": "Rating",
                  "fieldLabel": "Average",
                  "fields": {
                    "headingLevel": {
                      "render": false
                    },
                    "textAlign": {
                      "render": false
                    }
                  }
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "{{selector}} .tutor-ratings .tutor-ratings-average",
          "important": true
        }
      }
    }
  },
  "customCssFields": {},
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentMainContent": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentMainContent",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Content"
          }
        }
      },
      "designRatingStars": {
        "panel": "design",
        "priority": 10,
        "groupName": "designRatingStars",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "clipboardCategory": "style",
            "groupLabel": "Rating Stars"
          }
        }
      },
      "designRating": {
        "panel": "design",
        "priority": 20,
        "groupName": "designRating",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "clipboardCategory": "style",
            "groupLabel": "Rating",
            "presetGroup": "divi/font",
            "dynamicSubgroupHost": true
          }
        }
      }
    }
  }
}
