        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designStatusText",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": {
                  "grouped": false,
                  "groupLabel": "Status Text",
                  "fieldLabel": "Status Text",
                  "fields": {
                    "headingLevel": {
                      "render": false
                    },
                    "textAlign": {
                      "render": false
                    }
                  }
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "{{selector}} .progress-steps, {{selector}} .progress-percentage"
        }
      }
    },
    "progress": {
      "type": "object",
      "selector": "{{selector}} .tutor-progress-bar",
      "default": {
        "advanced": {
          "barHeight": {
            "desktop": {
              "value": "7px"
            }
          },
          "barRadius": {
            "desktop": {
              "value": "30px"
            }
          },
          "barGap": {
            "desktop": {
              "value": "10px"
            }
          }
        }
      },
      "settings": {
        "advanced": {
          "barColor": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designProgressBar",
              "attrName": "progress.advanced.barColor",
              "label": "Color",
              "priority": 10,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
