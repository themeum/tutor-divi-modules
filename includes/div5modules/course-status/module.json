              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 1,
                  "max": 100,
                  "step": 1,
                  "defaultUnit": "px",
                  "allowedUnits": ["px"]
                }
              }
            }
          },
          "barRadius": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designProgressBar",
              "attrName": "progress.advanced.barRadius",
              "label": "Border Radius",
              "priority": 40,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 1,
                  "max": 100,
                  "step": 1,
                  "defaultUnit": "px",
                  "allowedUnits": ["px"]
                }
              }
            }
          },
          "barGap": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designProgressBar",
              "attrName": "progress.advanced.barGap",
              "label": "Gap",
              "priority": 50,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 1,
                  "max": 100,
                  "step": 1,
                  "defaultUnit": "px",
                  "allowedUnits": ["px"]
                }
              }
            }
          }
        }
      }
