          "spacing": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "content": {
      "type": "object",
      "default": {
        "advanced": {
          "progressTitle": {
            "desktop": {
              "value": "Course Progress"
            }
          }
        }
      },
      "settings": {
        "advanced": {
          "progressTitle": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentMainContent",
              "attrName": "content.advanced.progressTitle",
              "label": "Progress Title",
              "priority": 10,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          }
        }
      }
    },
    "statusTitle": {
      "type": "object",
      "selector": "{{selector}} .dtlms-course-progress-title",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designStatusTitle",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": {
                  "grouped": false,
                  "groupLabel": "Status Title",
                  "fieldLabel": "Status Title",
                  "fields": {
                    "headingLevel": {
                      "render": false
                    },
                    "textAlign": {
                      "render": false
                    }
                  }
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "{{selector}} .dtlms-course-progress-title"
        }
      }
    },
    "statusText": {
      "type": "object",
      "selector": "{{selector}} .progress-steps, {{selector}} .progress-percentage",
