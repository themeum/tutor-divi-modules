  "customCssFields": {},
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentMainContent": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentMainContent",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Content"
          }
        }
      },
      "designStatusTitle": {
        "panel": "design",
        "priority": 10,
        "groupName": "designStatusTitle",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "clipboardCategory": "style",
            "groupLabel": "Progress Title",
            "presetGroup": "divi/font",
            "dynamicSubgroupHost": true
          }
        }
      },
      "designProgressBar": {
        "panel": "design",
        "priority": 20,
        "groupName": "designProgressBar",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
